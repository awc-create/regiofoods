# ======================================================
# Regio Foods — environment variables
# Copy to .env.local for local development.
# ======================================================

NEXT_PUBLIC_SITE_URL=https://regiofoods.in

# ---------- Database (Postgres) ----------
DATABASE_URL=postgresql://admin:admin@localhost:5432/regio?schema=public
DIRECT_DATABASE_URL=postgresql://admin:admin@localhost:5432/regio?schema=public

# ---------- Admin sign-in (NextAuth) ----------
# The admin runs on its own subdomain in production.
NEXTAUTH_URL=https://admin.regiofoods.in
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Optional: extra hostnames (comma separated)
# ADMIN_HOSTS=admin.staging.regiofoods.in
# PUBLIC_HOSTS=staging.regiofoods.in
# ADMIN_PUBLIC_HOST=admin.regiofoods.in

# ---------- Image uploads: Hetzner Object Storage (same as Prince Foods) ----------
HETZNER_S3_BUCKET=
HETZNER_S3_ENDPOINT=https://fsn1.your-objectstorage.com
HETZNER_S3_REGION=fsn1
HETZNER_S3_ACCESS_KEY_ID=
HETZNER_S3_SECRET_ACCESS_KEY=
HETZNER_S3_PUBLIC_BASE_URL=https://<bucket>.fsn1.your-objectstorage.com
# Folder prefix inside the bucket (default: regiofoods)
# HETZNER_S3_ROOT=regiofoods
# Set to public-read if the bucket has no public-read policy
# HETZNER_S3_ACL=public-read

# ---------- Optional: email copy of contact-form enquiries ----------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Regio Foods <no-reply@regiofoods.in>"

# ---------- First admin login (used by `yarn seed:admin`) ----------
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
